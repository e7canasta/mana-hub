# ══════════════════════════════════════════════════════════════════════════════
# mana-hub — .gitignore  (Kotlin 2.4 + Spring Boot 4 + Gradle 9 + PostgreSQL 17)
# ══════════════════════════════════════════════════════════════════════════════

# ── Gradle ──
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/integrationTest/**/build/

# ── Kotlin / Java ──
*.class
*.jar
*.war
*.ear
*.nar
out/
.kotlin/
hs_err_pid*
*.hprof
# keep gradle wrapper jar (debe ir DESPUÉS de *.jar para que la negación tenga efecto)
!gradle/wrapper/gradle-wrapper.jar

# ── IDE ──
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.project
.classpath
.factorypath
*.swp
*.swo
*~
.fleet/
.cursor/
.cursorignore
.claude/

# ── Obsidian (vault local, no es código) ──
.obsidian/

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Logs ──
*.log
logs/

# ── Coverage reports ──
build/reports/jacoco/
build/reports/coverage/
jacoco/
htmlcov/
*.exec
*.lcov
.coverage

# ── Environment / Secrets ──
.env
.env.*
!.env.example
*.pem
*.key
secrets.yml
secrets.yaml
application-local.yml
application-local.properties
application-*.local.yml
application-*.local.properties

# ── Database (local copies) ──
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.h2.db
*.mv.db
*.trace.db

# ── Temporary / Misc ──
tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
.cache/

# ── Informes generados ──
scripts/reports/generated/
